# Required
GEMINI_API_KEY=your-gemini-api-key-here
ADMIN_KEY=your-secret-admin-key-here

# Your domain (Caddy will auto-provision HTTPS via Let's Encrypt)
DOMAIN=nestleap.au

# Must match your live URL so the browser calls the right API
NEXT_PUBLIC_API_URL=https://nestleap.au

# Website paper portfolio rules: v2 (default) or legacy
PORTFOLIO_STRATEGY=v2

# ── Broker trading (docs/ROLLOUT.md) ─────────────────────────────────────────
# off | paper | live. Stage 0-1 use paper; only switch to live at stage 2.
TRADING_MODE=off
# sim = simulated fills at market prices (no broker needed) | ibkr = Interactive Brokers
TRADING_BROKER=sim
# manual = approve each week in the admin page | auto
TRADING_APPROVAL=manual
# Money model: deposit into a pool (record it: scripts/trading.sh deposit 5000).
# Each week at most TRADING_WEEKLY_NEW_MONEY is drawn from the pool for at most
# TRADING_MAX_BUYS_PER_WEEK buys; sale proceeds are re-bought or held on top of that.
TRADING_CURRENCY=EUR
TRADING_WEEKLY_NEW_MONEY=400
TRADING_MAX_BUYS_PER_WEEK=2
# USD bug guards: no single buy / weekly total above these
TRADING_MAX_ORDER_VALUE=2000
TRADING_MAX_WEEKLY_BUYS=4000
# Convert EUR to USD automatically when buys need it, at least this much at a time
TRADING_AUTO_FX=true
TRADING_FX_MIN_CONVERSION=1000
# Set false if `scripts/trading.sh check` shows fractional orders are not accepted
TRADING_FRACTIONAL=true
# Optional push notifications (ntfy app): https://ntfy.sh/<long-random-topic-name>
NOTIFY_URL=

# Interactive Brokers gateway (only with TRADING_BROKER=ibkr; start with --profile ibkr)
IB_USERNAME=
IB_PASSWORD=
# paper | live — must match TRADING_MODE (the app refuses to trade if they disagree)
IB_GATEWAY_MODE=paper
# 4004 = paper, 4003 = live
IB_PORT=4004
# Optional: account id if the login manages more than one (paper ids start with DU)
IB_ACCOUNT=
# Optional: monthly statement audit (Client Portal → Reports → Flex Queries / Flex Web Service)
IB_FLEX_TOKEN=
IB_FLEX_QUERY_ID=
